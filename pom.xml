<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.com.nichesdev</groupId>
    <artifactId>monevo-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>monevo-parent</name>

    <properties>
        <java.version>21</java.version>

        <!-- IMPORTANTE: Substitua esta versão pela mesma que o Spring Initializr gerar no pom.xml do Gateway -->
        <spring-cloud.version>2025.0.0</spring-cloud.version>
    </properties>

    <!-- Todos os seus microserviços atuais e futuros declarados aqui -->
    <modules>
        <module>userAuth</module>
        <module>gateway-monevo</module>
        <module>monevo-wallet</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>